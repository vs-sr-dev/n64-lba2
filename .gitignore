/cmake-build-*
/.idea/
CMakeUserPresets.json
out/
build/

# Local retail drop (symlink or copy classic data here; never commit assets)
/data/
/build_test
/build_logs/
.tmp/

# Polyrec rendered outputs (keep .lba2polyrec fixtures, ignore generated images)
tests/SNAPSHOT/fixtures/*.png
tests/SNAPSHOT/fixtures/*.ppm
tests/SNAPSHOT/fixtures/*.raw

# Wii U build output and packaged romfs content (assembled from local retail
# data by build-wiiu.sh; never commit game assets)
/build-wiiu/
/wuhb-content/

# N64 build output (lba2.z64 + DFS staged from local retail data by
# build-n64.sh; never commit game assets), emulator save RAM
/build-n64/
/lba2.z64
/lba2-audiodiag.z64
/lba2.dfs
/lba2.ram

# FMV probe working files (Smacker movies extracted from a local retail
# install and everything encoded from them; never commit game assets)
/tools-n64/fmv-probe/work/
/tools-n64/fmv-probe/filesystem/
/tools-n64/fmv-probe/fmvprobe.z64
